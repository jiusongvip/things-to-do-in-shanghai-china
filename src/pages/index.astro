<script is:inline>
  (function () {
    var PLAN = [
      { t:"Bund sunset stroll", tag:"icons", slug:"/attractions", price:0, fam:true, d:"The iconic free promenade — do it at golden hour." },
      { t:"Shanghai Tower deck", tag:"icons", slug:"/attractions", price:1, fam:false, d:"World's second-tallest building; vertigo-inducing views." },
      { t:"Yu Garden", tag:"icons", slug:"/attractions", price:1, fam:true, d:"A Ming-dynasty garden calm in the Old City." },
      { t:"French Concession walk", tag:"icons", slug:"/attractions", price:0, fam:true, d:"Plane-tree lanes, Art Deco, and the city's best cafes." },
      { t:"Jia Jia Tang Bao xiaolongbao", tag:"food", slug:"/food", price:0, fam:true, d:"The legendary soup-dumpling shop, pork or crab." },
      { t:"Yang's shengjianbao", tag:"food", slug:"/food", price:0, fam:true, d:"Golden, crisp pan-fried buns for under RMB 10." },
      { t:"Food crawl on Yunnan Road", tag:"food", slug:"/food", price:1, fam:true, d:"Hairy crab, hot pot, and late-night eats." },
