      { t:"Tianzifang arts & crafts", tag:"shopping", slug:"/shopping", price:0, fam:true, d:"Artisan studios in hidden lane houses." },
      { t:"South Bund Fabric Market", tag:"shopping", slug:"/shopping", price:1, fam:false, d:"Custom suits tailored in 48 hours." },
      { t:"Flair Rooftop bar", tag:"night", slug:"/nightlife", price:2, fam:false, d:"Shanghai's highest rooftop, skyline to both banks." },
      { t:"Speak Low speakeasy", tag:"night", slug:"/nightlife", price:2, fam:false, d:"Hidden bar behind a bookshelf; Asia's 50 Best." },
      { t:"Shanghai Museum (free)", tag:"icons", slug:"/free", price:0, fam:true, d:"World-class bronze & ceramics, free with reservation." },
      { t:"M50 Art District", tag:"nature", slug:"/free", price:0, fam:true, d:"Galleries in a converted textile mill." },
      { t:"Century Park", tag:"nature", slug:"/with-kids", price:1, fam:true, d:"Shanghai's largest park; picnic and play lawns." },
      { t:"Huangpu night cruise", tag:"night", slug:"/attractions", price:1, fam:true, d:"Best after 8 PM, both skylines lit." },
      { t:"Zhujiajiao water town", tag:"nature", slug:"/day-trips", price:1, fam:true, d:"Canal town an hour away by Metro." },
    ];
    var sel = { group:'', days:'', budget:'', interest:'' };
    var boxes = document.querySelectorAll('#planner [data-q]');
    var go = document.getElementById('planner-go');
    var results = document.getElementById('planner-results');
    Array.prototype.forEach.call(boxes, function (box) {
      Array.prototype.forEach.call(box.querySelectorAll('button'), function (btn) {
        btn.addEventListener('click', function () {
          var parent = btn.parentNode;
          Array.prototype.forEach.call(parent.querySelectorAll('button'), function (b) {
            b.classList.remove('border-brand-500', 'text-brand-700', 'bg-brand-50');
            b.classList.add('border-neutral-200', 'text-neutral-700');
          });
          btn.classList.add('border-brand-500', 'text-brand-700', 'bg-brand-50');
          btn.classList.remove('border-neutral-200', 'text-neutral-700');
          sel[parent.getAttribute('data-q')] = btn.getAttribute('data-opt');
          go.disabled = !(sel.group && sel.days && sel.budget && sel.interest);
          go.style.opacity = go.disabled ? '0.4' : '1';
        });
      });
    });
    go.addEventListener('click', function () {
      var list = PLAN.filter(function (p) {
        if (sel.budget === 'free' && p.price > 0) return false;
        if (sel.budget === 'mid' && p.price > 1) return false;
        if (sel.budget === 'lux' && p.price < 1) return false;
        return true;
      });
      var tagCap = { icons:4, food:3, shopping:3, night:3, nature:3 };
      list = list.sort(function (a, b) {
        var score = function (p) {
          var s = 0;
          if (p.tag === sel.interest) s += 40;
          return s;
        };
        return score(b) - score(a);
      });
      if (sel.group === 'family') list = list.filter(function(p){ return p.fam; });
      var max = sel.days === '1' ? 5 : sel.days === '3' ? 8 : 10;
      var top = list.slice(0, max);
      if (!top.length) top = PLAN.slice(0, 5);
      results.innerHTML = '';
      top.forEach(function (p, i) {
        var el = document.createElement('a');
        el.href = p.slug;
        el.className = 'flex items-center justify-between gap-3 rounded-xl border border-neutral-200 bg-white px-4 py-3 transition hover:border-brand-200 hover:shadow-sm';
        el.innerHTML = '<div><span class="mr-2 text-xs font-bold text-brand-400">' + (i+1) + '</span><span class="text-sm font-semibold text-neutral-800">' + p.t + '</span><p class="mt-0.5 text-xs text-neutral-500">' + p.d + '</p></div><span class="text-brand-600">\u2192</span>';
        results.appendChild(el);
      });
    });
  })();
</script>

