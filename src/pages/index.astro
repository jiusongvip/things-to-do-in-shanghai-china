---
import BaseLayout from "../layouts/BaseLayout.astro";

const quickCategories = [
  { name: "Attractions", icon: "landmark", slug: "/attractions", description: "Iconic landmarks and hidden gems", color: "from-amber-400 to-orange-500" },
  { name: "Food & Dining", icon: "utensils", slug: "/food", description: "Street eats to Michelin stars", color: "from-rose-400 to-red-500" },
  { name: "Nightlife", icon: "martini", slug: "/nightlife", description: "Rooftop bars and speakeasies", color: "from-indigo-400 to-purple-500" },
  { name: "Shopping", icon: "bag", slug: "/shopping", description: "Markets, malls, and boutiques", color: "from-emerald-400 to-teal-500" },
  { name: "Day Trips", icon: "train", slug: "/day-trips", description: "Water towns and ancient cities", color: "from-sky-400 to-blue-500" },
  { name: "With Kids", icon: "smile", slug: "/with-kids", description: "Family-friendly adventures", color: "from-pink-400 to-rose-400" },
  { name: "Free Things", icon: "ticket", slug: "/free", description: "Amazing experiences at zero cost", color: "from-lime-400 to-green-500" },
  { name: "Itineraries", icon: "map", slug: "/itinerary", description: "3-day and 5-day plans", color: "from-cyan-400 to-sky-500" },
];

const topPicks = [
  { num: "01", title: "Walk the Bund", desc: "Shanghai's iconic waterfront promenade — colonial architecture on one side, futuristic Pudong skyline on the other. Best at golden hour.", img: "/images/shanghai/bund-day.webp", alt: "The Bund waterfront and Pudong skyline at golden hour", slug: "/the-bund" },
  { num: "02", title: "Ascend Shanghai Tower", desc: "The world's second-tallest building. The 118th-floor observation deck delivers a vertigo-inducing view of the entire city.", img: "/images/shanghai/shanghai-tower.webp", alt: "View from the Shanghai Tower observation deck", slug: "/shanghai-tower" },
  { num: "03", title: "Get Lost in Yu Garden", desc: "A 16th-century classical Chinese garden tucked in the Old City. Rockeries, pavilions, koi ponds — pure Ming-dynasty serenity.", img: "/images/shanghai/yu-garden.webp", alt: "Yu Garden classical pavilions and pond", slug: "/yu-garden" },
  { num: "04", title: "Eat Xiaolongbao", desc: "Shanghai's signature soup dumplings. Thin-skinned, juicy, scalding-hot broth inside. Din Tai Fung for polish, Jia Jia Tang Bao for the real deal.", img: "/images/shanghai/xiaolongbao.webp", alt: "Steamed xiaolongbao soup dumplings in a basket", slug: "/xiaolongbao" },
  { num: "05", title: "Stroll the French Concession", desc: "Plane-tree-lined streets, Art Deco apartments, and the city's best cafes and boutiques. Rent a bike and wander without a map.", img: "/images/shanghai/wukang-road.webp", alt: "Plane trees along Wukang Road in the French Concession", slug: "/french-concession" },
];

const topThings = [
  { t: "01", title: "Walk the Bund", cat: "Attraction", desc: "Shanghai's iconic waterfront promenade. Colonial buildings on one side, Pudong skyline on the other. Free to stroll; best at golden hour.", info: "Free forever-time | Nearest Metro: Line 2 & 10, East Nanjing Road | Allow 1–2 hrs", slug: "/the-bund" },
  { t: "02", title: "Ascend Shanghai Tower", cat: "Attraction", desc: "World's second-tallest building. The 118th-floor observation deck delivers a vertigo-inducing view across the whole city.", info: "RMB 180–220 · Open daily 08:30–22:00 · Allow 1.5 hrs", slug: "/shanghai-tower" },
  { t: "03", title: "Get Lost in Yu Garden", cat: "Attraction", desc: "A 16th-century classical Chinese garden tucked in the Old City. Rockeries, pavilions, koi ponds — pure Ming-dynasty serenity.", info: "RMB 40 · Open 09:00–16:30 · Allow 1–2 hrs", slug: "/yu-garden" },
  { t: "04", title: "Eat Xiaolongbao at Jia Jia Tang Bao", cat: "Food", desc: "Shanghai's signature soup dumplings. Thin-skinned, pork-filled, scalding broth inside. Tiny shop with one item on the menu.", info: "RMB 20–60 · Seat from 10:00, queues start from 11:00", slug: "/xiaolongbao" },
  { t: "05", title: "Stroll the French Concession", cat: "Attraction", desc: "Plane-tree-lined streets, Art Deco apartments, the city's best cafes. Rent a bike and wander without a map.", info: "Free · Start at Wukang Road · Allow half a day", slug: "/french-concession" },
  { t: "06", title: "Ride the Shanghai Maglev", cat: "Transport", desc: "The fastest commercial train on Earth — 431 km/h from Pudong Airport to the city in 8 minutes. A fun, practical ride.", info: "RMB 50 single / RMB 30 with same-day air ticket · Every 15 min", slug: "/attractions" },
  { t: "07", title: "Take a Huangpu River Night Cruise", cat: "Attraction", desc: "Watch Bund and Lujiazui skylines light up from the water. Book the 19:00 onwards sailings for the full effect.", info: "RMB 100–150 · Boats depart from Shiliupu Wharf", slug: "/huangpu-river-cruise" },
  { t: "08", title: "Shanghai Old Street & City God Temple", cat: "Attraction", desc: "Winding alleys of teas, crafts and snacks around the City God Temple, next to Yu Garden.", info: "Free entry · Streets open all day · Temple RMB 10", slug: "/attractions" },
  { t: "09", title: "Ride the Bund Sightseeing Tunnel", cat: "Attraction", desc: "A kitschy sci-fi light tunnel under the Huangpu River. Tourist fun, best for kids and gamblers of kitsch.", info: "RMB 50 · Rides both ways all day", slug: "/with-kids" },
  { t: "10", title: "Zhongshan Park Weekend Markets", cat: "Shopping", desc: "Lantern markets, bubble tea and street snacks that fill landmarks from Friday afternoon.", info: "Free · Weekends only", slug: "/shopping" },
  { t: "11", title: "Eat Shengjianbao at Yang's Fried Dumplings", cat: "Food", desc: "The gold standard for pan-fried soup dumplings. Tender, crispy, dripping with broth. Multiple locations citywide.", info: "RMB 8 for 4 ⸏ Try the pork+ginger", slug: "/food" },
  { t: "12", title: "Xintiandi's Shikumen Lane Houses", cat: "Attraction", desc: "Restored stone-gate courtyard houses turned into stylish bars, boutiques and the site of the city's first Communist meeting.", info: "Free · Open all day", slug: "/attractions" },
  { t: "13", title: "Jing'an Temple", cat: "Attraction", desc: "A Song-dynasty Buddhist temple squeezed between skyscrapers. Calm, atmospheric and worth the incense crowd.", info: "RMB 50 · Open 07:00–17:00", slug: "/attractions" },
  { t: "14", title: "Shanghai Museum (People's Square)", cat: "Attraction", desc: "One of the world's best collection of ancient Chinese bronze, ceramics, calligraphy and jade.", info: "Free (reserve) · Open Tue–Sun 09:00–17:00", slug: "/attractions" },
  { t: "15", title: "Flair Rooftop, Ritz-Carlton Pudong", cat: "Nightlife", desc: "Highest rooftop bar in Shanghai, on the 58th floor with sweeping skyline views over both banks.", info: "Dress code · Book ahead · Happy hour 17:00–20:00", slug: "/nightlife" },
  { t: "16", title: "Speak Low Speakeasy", cat: "Nightlife", desc: "A hidden bar behind a barbershop bookshelf. Regular on Asia's 50 Best Bars list.", info: "No reservation · Go early · Take the back door", slug: "/nightlife" },
  { t: "17", title: "Nanjing Road Pedestrian Street", cat: "Shopping", desc: "Shanghai's famous 5.5 km retail drag. Neon, malls, and an endless strip of shops and snacks for day or night.", info: "Free · Busiest by early evening", slug: "/shopping" },
  { t: "18", title: "Tianzifang's Hidden Alleys", cat: "Shopping", desc: "Maze of narrow lanes stuffed with artisan studios, indie boutiques and craft shops in the former French Concession.", info: "Free · Crowded weekends · Allow 2 hrs", slug: "/shopping" },
  { t: "19", title: "The Long Quan Wharf & Silos", cat: "Attraction", desc: "Converted art precinct of brick silos and galleries along the water — unexpected and quietly beautiful.", info: "Free · Open daily · Good cafe nearby", slug: "/attractions" },
  { t: "20", title: "Longhua Temple", cat: "Attraction", desc: "Shanghai's oldest and largest Buddhist temple, a quieter counterpoint to Jing'an.", info: "RMB 10 · Open 07:00–16:30", slug: "/attractions" },
  { t: "21", title: "Yuyuan Bazaar Craft Market", cat: "Shopping", desc: "Shops are souvenirs, umbrellas, tea sets and jade around the historic garden.", info: "Free · Combine with Yu Garden", slug: "/shopping" },
  { t: "22", title: "The Bund History Museum (free)", cat: "Free", desc: "A small but free museum tracing how the Bund's skyline and port were built up over 150 years.", info: "Free · Open Tue–Sun · Allow 1 hr", slug: "/free" },
  { t: "23", title: "M50 Art District", cat: "Attraction", desc: "Shanghai's creative hub of independent galleries, studios and painters in converted warehouses.", info: "Free · Open 10:00–18:00 · Closes Mondays", slug: "/attractions" },
  { t: "24", title: "Waitan North / North Bund riverside", cat: "Attraction", desc: "A quiet waterfront boardwalk on the opposite bank with calm views back at the Pudong skyline.", info: "Free · At sunset", slug: "/free" },
  { t: "25", title: "Explore the M50 Water Town day trip", cat: "Day Trip", desc: "For a half-day out of Shanghai, try Zhujiajiao or Qibao — canals, bridges and tea houses a short metro ride away.", info: "Train/subway ~1 hr · Free entry", slug: "/day-trips" },
  { t: "26", title: "Trip the Longhua Pagoda Park", cat: "Attraction", desc: "A peaceful Buddhist park with the famed Longhua Pagoda ringed by incense and locals.", info: "Free · Open daily", slug: "/attractions" },
  { t: "27", title: "Shanghai Grand Theatre evening", cat: "Nightlife", desc: "Catch a symphony, ballet or Chinese opera in People's Square — book online, dress well.", info: "From RMB 80 · Book ahead", slug: "/nightlife" },
  { t: "28", title: "Sip Coffee in the Fuxing Park lanes", cat: "Food", desc: "Brunch and third-wave coffee at slow cafes facing the plane-tree parks of the old French Concession.", info: "Free to stroll · Cafés vary", slug: "/food" },
  { t: "29", title: "Take in the view from Sheshan hill", cat: "Day Trip", desc: "Shanghai's only real hill — a short rail hop out west with forest hikes and a basil church on top.", info: "Metro Line 9 · Free", slug: "/day-trips" },
  { t: "30", title: "Night markets on the Old City lanes", cat: "Food", desc: "A buzzing strip of seafood stalls, dumplings and skewers that comes alive as the lanterns switch on around Yu Garden.", info: "Dinner from around 18:00 → late", slug: "/food" },
];

const itineraryTeasers = [
  { days: "3 Days", title: "The Essentials", desc: "Bund, Yu Garden, Shanghai Tower, French Concession, and a Huangpu River cruise. Perfect for a long weekend.", slug: "/itinerary" },
  { days: "5 Days", title: "The Deep Dive", desc: "Everything in the 3-day plan plus day trips, museum visits, and neighborhood explorations. See Shanghai properly.", slug: "/itinerary" },
];

const budgetTiers = [
  { tier: "Budget", perDay: "RMB 800", desc: "Hostels, street food, the Metro, and free attractions. You can see nearly everything on the budget plan — you just sleep and eat simply.", accent: "" },
  { tier: "Comfortable", perDay: "RMB 2,000", desc: "Mid-range hotels, sit-down meals, occasional taxis, and paid entry to every major site. The sweet spot for most trips.", accent: "ring-brand-200 bg-brand-50 border-brand-200" },
  { tier: "Luxury", perDay: "RMB 5,000+", desc: "Best hotels, fine dining, private guides, and hassle-free transport. Zero compromises.", accent: "" },
];

const freeThings = [
  { name: "The Bund at sunset", slug: "/free" },
  { name: "French Concession wander", slug: "/free" },
  { name: "Shanghai Museum", slug: "/free" },
  { name: "M50 Art District", slug: "/free" },
  { name: "People's Park Marriage Market", slug: "/free" },
  { name: "Power Station of Art", slug: "/free" },
];

const dayTrips = [
  { name: "Suzhou", time: "30 min", slug: "/day-trips", desc: "UNESCO classical gardens and canals." },
  { name: "Hangzhou", time: "45 min", slug: "/day-trips", desc: "West Lake mist and tea plantations." },
  { name: "Zhujiajiao", time: "1 hr", slug: "/day-trips", desc: "Shanghai's closest water town." },
  { name: "Wuzhen", time: "2 hrs", slug: "/day-trips", desc: "Ancient canals lit by lanterns at night." },
];

const kidsGroups = [
  { label: "Under 6", picks: "Shanghai Ocean Aquarium, Century Park, Bund Sightseeing Tunnel", note: "Stroller-friendly, gentle, and never overwhelming." },
  { label: "Ages 6+", picks: "Science & Tech Museum, Shanghai Circus World, Disneyland", note: "Unforgettable, high-energy adventures." },
];

const faqs = [
  { q: "When is the best time to visit Shanghai?", a: "Spring (March to May) and autumn (September to November) offer pleasant weather and clear skies. Summers are hot and humid; winters are chilly but manageable. Avoid Chinese New Year (late Jan/Feb) when many businesses close." },
  { q: "How many days do I need in Shanghai?", a: "Three full days covers the essentials. Five days lets you explore neighborhoods, take a day trip, and discover the food scene at a relaxed pace." },
  { q: "Is Shanghai safe for tourists?", a: "Yes — Shanghai is one of the safest major cities in the world. Violent crime is rare. Standard precautions apply: watch for pickpockets in crowded areas and use official taxis or ride-hailing apps." },
  { q: "Do I need a visa for Shanghai?", a: "Most visitors need a Chinese visa. However, Shanghai offers a 144-hour (6-day) transit visa exemption for travelers from 53 countries who are transiting to a third country. Check current policy before booking." },
  { q: "What's the best way to get around Shanghai?", a: "The Metro is clean, extensive, and cheap (RMB 3-9 per ride). Didi (Chinese Uber) is affordable and convenient. Avoid rush hour (7:30-9:00 AM and 5:00-7:00 PM)." },
];
---

<BaseLayout
  title="Home"
  description="The best things to do in Shanghai, China: top 30 attractions, food, nightlife, shopping and day trips, mapped and rated by a local travel writer."
  author="Jamie Chen, Shanghai-based Travel Writer"
  datePublished="2026-01-15"
  dateModified="2026-08-01"
  isArticle
>
  <script slot="schema" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Top 30 Things to Do in Shanghai, China",
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": 30,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Walk the Bund" },
        { "@type": "ListItem", "position": 2, "name": "Ascend Shanghai Tower" },
        { "@type": "ListItem", "position": 3, "name": "Get Lost in Yu Garden" },
        { "@type": "ListItem", "position": 4, "name": "Eat Xiaolongbao at Jia Jia Tang Bao" },
        { "@type": "ListItem", "position": 5, "name": "Stroll the French Concession" },
        { "@type": "ListItem", "position": 6, "name": "Ride the Shanghai Maglev" },
        { "@type": "ListItem", "position": 7, "name": "Huangpu River Night Cruise" },
        { "@type": "ListItem", "position": 8, "name": "Shanghai Old Street & City God Temple" },
        { "@type": "ListItem", "position": 9, "name": "Bund Sightseeing Tunnel" },
        { "@type": "ListItem", "position": 10, "name": "Zhongshan Park Weekend Markets" }
      ]
    }
  </script>
  <script slot="schema" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "When is the best time to visit Shanghai?", "acceptedAnswer": { "@type": "Answer", "text": "Spring (March to May) and autumn (September to November) offer pleasant weather and clear skies. Summers are hot and humid; winters are chilly but manageable. Avoid Chinese New Year (late Jan/Feb) when many businesses close." } },
        { "@type": "Question", "name": "How many days do I need in Shanghai?", "acceptedAnswer": { "@type": "Answer", "text": "Three full days covers the essentials. Five days lets you explore neighborhoods, take a day trip, and discover the food scene at a relaxed pace." } },
        { "@type": "Question", "name": "Is Shanghai safe for tourists?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — Shanghai is one of the safest major cities in the world. Violent crime is rare. Standard precautions apply: watch for pickpockets in crowded areas and use official taxis or ride-hailing apps." } },
        { "@type": "Question", "name": "Do I need a visa for Shanghai?", "acceptedAnswer": { "@type": "Answer", "text": "Most visitors need a Chinese visa. However, Shanghai offers a 144-hour (6-day) transit visa exemption for travelers from 53 countries who are transiting to a third country. Check current policy before booking." } },
        { "@type": "Question", "name": "What's the best way to get around Shanghai?", "acceptedAnswer": { "@type": "Answer", "text": "The Metro is clean, extensive, and cheap (RMB 3-9 per ride). Didi (Chinese Uber) is affordable and convenient. Avoid rush hour (7:30-9:00 AM and 5:00-7:00 PM)." } }
      ]
    }
  </script>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-neutral-900">
    <div class="absolute inset-0">
      <img
          src="/images/shanghai/hero-bund.webp"
          alt="Shanghai Pudong skyline at dusk"
          class="h-full w-full object-cover opacity-60"
          width="1200"
          height="630"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-900/60 via-neutral-900/40 to-neutral-900/80"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 pb-24 pt-32 md:pb-32 md:pt-40">
      <div class="max-w-2xl">
        <p class="mb-4 text-sm font-medium uppercase tracking-widest text-brand-300">Shanghai Travel Guide</p>
        <h1 class="text-4xl font-extrabold leading-none tracking-tight text-white md:text-6xl">
          Things to Do in<br />Shanghai, China
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-neutral-300">
          From the futuristic Pudong skyline to hidden lane-house cafes, discover the best of Shanghai with our curated, locally-informed guide — every spot mapped and ranked for 2026.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#top-30" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/25 transition-all hover:bg-brand-600 active:scale-[0.98]">
            See the Top 30 List
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
          <a href="#map" class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 active:scale-[0.98]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Open Interactive Map
          </a>
          <a href="/itinerary" class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 active:scale-[0.98]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
            View Itineraries
          </a>
          <a href="#planner" class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition-all hover:bg-white/20 active:scale-[0.98]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
            Take the Quiz
          </a>
        </div>
        <dl class="mt-12 grid max-w-xl grid-cols-3 gap-6 border-t border-white/15 pt-8">
          <div>
            <dt class="text-2xl font-extrabold text-white md:text-3xl">30</dt>
            <dd class="mt-1 text-xs font-medium uppercase tracking-widest text-neutral-400">Ranked things to do</dd>
          </div>
          <div>
            <dt class="text-2xl font-extrabold text-white md:text-3xl">25+</dt>
            <dd class="mt-1 text-xs font-medium uppercase tracking-widest text-neutral-400">Map pins</dd>
          </div>
          <div>
            <dt class="text-2xl font-extrabold text-white md:text-3xl">3 &amp; 5</dt>
            <dd class="mt-1 text-xs font-medium uppercase tracking-widest text-neutral-400">Day itineraries</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Quick Categories -->
  <section id="categories" class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-14">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-500">Explore by Category</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-neutral-900 md:text-4xl">What kind of experience<br />are you looking for?</h2>
      </div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        {quickCategories.map((cat) => (
          <a href={cat.slug} class="group relative overflow-hidden rounded-2xl border border-neutral-200 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-100/50 md:p-6">
            <div class={`mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br ${cat.color} text-white shadow-sm`}>
              {cat.icon === "landmark" && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9v11"/><path d="M18 9v11"/><path d="M4 22h16"/><path d="M2 9h20"/><path d="M12 2l6 6"/><path d="M12 2l-6 6"/><path d="M12 2v7"/></svg>}
              {cat.icon === "utensils" && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="M3 6h18"/><path d="M3 18h18"/></svg>}
              {cat.icon === "martini" && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22h12"/><path d="M21 3 12 14"/><path d="M3 3h18"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>}
              {cat.icon === "bag" && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>}
              {cat.icon === "train" && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="16" rx="2"/><path d="M4 11h16"/><path d="M12 3v8"/><path d="m8 19-2 3"/><path d="m18 22-2-3"/><path d="M8 15h.01"/><path d="M16 15h.01"/></svg>}
