---
import BaseLayout from "../layouts/BaseLayout.astro";

const spots = [
  { name: "Flair Rooftop", type: "Rooftop Bar", desc: "The Ritz-Carlton Pudong's 58th-floor bar. The highest rooftop in Shanghai with outdoor seating. Unobstructed views of the Bund and the Pearl Tower.", area: "Pudong", img: "/images/picsum-19-3dgy.webp" },
  { name: "Speak Low", type: "Speakeasy", desc: "Hidden behind a bookshelf in a bartending supply shop. Four floors, each with a different concept. Consistently ranked among Asia's 50 Best Bars.", area: "French Concession", img: "/images/picsum-20-3fxn.webp" },
  { name: "The Bund Bar Crawl", type: "Experience", desc: "Start at the Peace Hotel Jazz Bar (Shanghai's oldest), hit Captain's Bar, then end at Bar Rouge for skyline views and a club scene that goes until dawn.", area: "The Bund", img: "/images/picsum-21-3ic9.webp" },
  { name: "M1NT", type: "Club", desc: "High-end club on the Bund with a shark tank above the bar. Dress code is strict. The crowd is international and well-heeled.", area: "The Bund", img: "/images/picsum-22-3ks1.webp" },
  { name: "Huangpu River Night Cruise", type: "Experience", desc: "A 45-minute cruise past the fully lit Bund and Pudong skylines. Tourist-heavy but genuinely spectacular. Go after 8 PM when everything is illuminated.", area: "The Bund", img: "/images/picsum-23-3n7h.webp" },
  { name: "The Odd Couple", type: "Cocktail Bar", desc: "Retro 80s-themed cocktail bar from the Speak Low team. Pac-Man machines, neon lights, and seriously good drinks with a playful menu.", area: "French Concession", img: "/images/picsum-24-3pmk.webp" },
  { name: "Arkham", type: "Live Music / Club", desc: "Underground venue for electronic, hip-hop, and indie acts. One of the few places in Shanghai where the music really matters more than the scene.", area: "Jing'an", img: "/images/picsum-25-3s0g.webp" },
  { name: "Lost Heaven", type: "Dinner + Bar", desc: "Yunnan-inspired cuisine in a lantern-lit courtyard on the Bund. The Silk Road cocktails are famous. Great for a slower-paced, atmospheric evening.", area: "The Bund", img: "/images/picsum-26-3ugd.webp" },
];
---

<BaseLayout
  title="Shanghai Nightlife Guide"
  description="Experience Shanghai after dark: rooftop bars with skyline views, hidden speakeasies, live music clubs, and river cruises. Complete nightlife guide."
>
  <section class="bg-neutral-900 py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-300">Nightlife</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-none tracking-tight text-white md:text-6xl">
        Shanghai Nightlife Guide
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-neutral-300">
        After sunset, Shanghai transforms. Rooftop cocktails above the skyline, hidden speakeasies behind bookshelves, and clubs that don't stop until sunrise.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900">Shanghai after dark is a different city</h2>
      <p class="mt-4 leading-relaxed text-neutral-600">
        When the office towers empty and the Bund's colonial facades light up, Shanghai transforms. The nightlife scene is unexpectedly diverse: one evening might start with craft cocktails behind a hidden bookshelf in the French Concession, continue with a <a href="/food/" class="text-brand-600 underline underline-offset-2 hover:text-brand-700">late-night food crawl</a> along Yunnan Road, and end at a rooftop bar where the Pudong skyline glitters in the river below. The dress code varies wildly — Flair and Bar Rouge enforce it strictly (no shorts, no flip-flops), while underground venues like Arkham care more about your music taste than your shoes.
      </p>
      <p class="mt-3 leading-relaxed text-neutral-600">
        A practical note on timing: Chinese bars and clubs do not have legally mandated closing times the way many Western cities do. Some venues stay open until the last guest leaves, which on weekends can mean 4:00 or 5:00 AM. The Huangpu River cruise is best taken between 8:00 and 9:00 PM when all the lights are on. Rooftop bars fill up by 7:00 PM for sunset; arrive by 6:30 to secure a rail-side spot. Cocktails at top-tier bars average RMB 90-120 — expensive by local standards but a bargain compared to New York, London, or Tokyo.
      </p>
    </div>
  </section>

  <section class="bg-neutral-50 py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-2xl font-bold tracking-tight text-neutral-900">How to do Shanghai nightlife right</h2>
      <p class="mt-4 leading-relaxed text-neutral-600">
        Most visitors make one mistake: they over-schedule. A great Shanghai night needs only one ridge experience, not five. The formula that works is to pick a single anchor — a rooftop with sunset views, or a speakeasy — and let the evening flow from there. Shanghai's nightlife is spread across distinct neighborhoods, so think in terms of areas rather than venues: the Bund for skyline bars and upscale clubs, the French Concession for hidden speakeasies and intimate cocktail lounges, Jing'an for live music and indie venues.
      </p>
      <p class="mt-3 leading-relaxed text-neutral-600">
        Two practical realities visitors often underestimate. First, dress codes: Flair and Bar Rouge enforce theirs strictly — no sportswear, no flip-flops. Second, many hidden bars require a secret entrance or a membership in name only — look for the unmarked door and just say you are a friend of the house. If you want the classic experience, end the night with food: late-night dumpling stalls and noodle shops on Yunnan Road run until 3:00 AM. Start around 8:00 PM, switch venues around 10:30, and you will catch Shanghai at its liveliest.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {spots.map((s) => (
          <article class="group overflow-hidden rounded-2xl border border-neutral-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="aspect-[16/10] overflow-hidden">
              <img src={s.img} alt={s.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" width="1200" height="750" loading="lazy" decoding="async" />
            </div>
            <div class="p-5 md:p-6">
              <div class="mb-2 flex items-center gap-2">
                <span class="rounded-md bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">{s.type}</span>
                <span class="text-xs text-neutral-400">{s.area}</span>
              </div>
             <h2 class="text-lg font-bold text-neutral-900">{s.name}</h2>
              <div class="mt-3 border-t border-neutral-100 pt-3">
                <h3 class="mb-1 text-xs font-semibold uppercase tracking-wider text-neutral-400">About</h3>
                <p class="text-sm leading-relaxed text-neutral-500">{s.desc}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
